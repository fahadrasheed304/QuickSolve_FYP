# Copy to .env.local and enter values locally. Never commit real secrets.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
ADMIN_PASSWORD=
SMTP_EMAIL=
SMTP_PASSWORD=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Enable only after applying the recording migration and configuring storage/webhooks/cron.
RECORDING_ENABLED=false
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Random secret used by the recording maintenance scheduler (Bearer authentication).
CRON_SECRET=
# This application deliberately accepts Stripe test keys only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
